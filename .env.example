# TukShop / ecomWatch migration — fill these in outside Git.
NEXTAUTH_URL=https://tukshop.ratchavit.com
NEXTAUTH_SECRET=
NEXT_PUBLIC_URL=https://tukshop.ratchavit.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep off until checkout currency, stock, and webhook idempotency are tested.
CHECKOUT_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Restaurant opaque tracking/idempotency: persistent server-only random secret, >=32 chars.
# Do not expose as NEXT_PUBLIC_*; no online payments are enabled by this setting.
FOOD_TRACKING_SECRET=
